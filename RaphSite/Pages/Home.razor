@page "/"

<PageTitle>Mvie Zibi Raphael – Développeur senior .NET</PageTitle>

<div class="cv">
    <aside class="identite">

        <div style="display: flex; justify-content: center;">
            <img src="raphpic.jpg" class="img-thumbnail" alt="Photo de Raphael"
                 style="border-radius: 50%; width: 280px; height: 280px; object-fit: cover;">
        </div>
        <div >
            <h1 style="text-align: center; width: 100%;">Mvie Zibi Raphael</h1>
            <p class="titre">Développeur Senior (.NET C#/ React / Angular /TypeScript,Azure) et analyste développeur</p>
            <p class="lieu">Québec, Canada</p>
        </div>

        <div>
            <ul class="contact">
                <li><a href="mailto:ton@email.com">ton@email.com</a></li>
                <li><a href="https://www.linkedin.com/in/ton-profil">LinkedIn</a></li>
                <li><a href="https://github.com/ton-utilisateur">GitHub</a></li>
            </ul>  
        </div>
        <a class="telecharger" href="cv.pdf" download>Télécharger mon CV en PDF</a>
    </aside>

    <div class="contenu">
       
        
        <section>
            <h2>Profil</h2>
            <p>
                Développeur Senior full stack et analyste développeur avec 11+ ans d'expérience et 40+ applications livrées (web, API, mobile). Je passe
                du besoin métier à la solution en production : analyse, architecture (Clean Architecture, microservices), développement, tests, CI/CD et
                déploiement sur Azure et AWS. J'ai dirigé des équipes Scrum jusqu'à 16 personnes et fait le lien entre équipes techniques et parties
                prenantes. Je me décris en somme en qualité de spécialiste de la donnée car je gère son cycle de la création à la visualisation.
            </p>
        </section>

        <section>
            <h2>Compétences</h2>
            <dl class="competences">
                @foreach (var groupe in competences)
                {
                    <div>
                        <dt>@groupe.Titre</dt>
                        <dd>@string.Join(", ", groupe.Elements)</dd>
                    </div>
                }
            </dl>
        </section>

        <section>
            <h2>Expérience</h2>
            @foreach (var poste in experiences)
            {
                <article class="poste">
                    <h3>@poste.Titre</h3>
                    <p class="meta"><strong>@poste.Entreprise</strong> <span>@poste.Periode</span></p>
                    <p>@poste.Resume</p>
                </article>
            }
        </section>

        <section>
            <h2>Certifications</h2>
            <ul class="certifs">
                @foreach (var certif in certifications)
                {
                    <li><strong>@certif.Nom</strong> <span>@certif.Annee</span></li>
                }
            </ul>
        </section>
    </div>
</div>

@code {
    private record Groupe(string Titre, string[] Elements);
    private record Poste(string Titre, string Entreprise, string Periode, string Resume);
    private record Certif(string Nom, string Annee);

    private readonly Groupe[] competences =
    {
        new("Back-end", new[] { "C#", "ASP.NET Core", "Entity Framework", "GraphQL", "RabbitMQ" }),
        new("Front-end", new[] { "React", "Angular", "TypeScript" }),
        new("Données", new[] { "SQL Server", "NoSQL et cache", "Power BI", "Python" }),
        new("Cloud et DevOps", new[] { "Azure", "AWS", "Docker", "Kubernetes", "Podman", "Terraform", "CI/CD", "Linux" }),
        new("Architecture et qualité", new[] { "Systèmes multi-tenants", "Commerce électronique", "CUPID", "Application Insights", "OpenTelemetry" })
    };

    // À remplacer par tes vrais postes
    private readonly Poste[] experiences =
    {
        new("Développeur senior full stack", "Entreprise A", "20XX – aujourd'hui",
            "Décris ici ta mission principale, les technologies utilisées et un résultat concret."),
        new("Analyste développeur", "Entreprise B", "20XX – 20XX",
            "Décris ici ce que tu as livré et l'impact pour l'équipe ou les clients.")
    };

    private readonly Certif[] certifications =
    {
        new("Microsoft Power BI Data Analyst Associate", "2024"),
        new("Python pour l'analyse de données", "2024")
    };
}
